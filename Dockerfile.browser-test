FROM golang:1.26-trixie AS go-toolchain

# 复用生产运行镜像中已经安装并验证过的 Chromium、Node 和 Playwright driver，
# 只补 Go 工具链来执行真实浏览器集成测试。
FROM ydisks-xianyu-helper:functional
ENV PATH=/usr/local/go/bin:${PATH}
ENV CGO_ENABLED=0
WORKDIR /src
COPY --from=go-toolchain /usr/local/go /usr/local/go
# 网络受限环境使用 goproxy.cn 镜像拉取 Go 模块，避免直连 proxy.golang.org 超时。
ENV GOPROXY=https://goproxy.cn,direct
COPY go.mod go.sum ./
RUN go mod download
COPY . .
CMD ["go", "test", "-timeout=2m", "./internal/browser", "-run", "TestTokenCaptchaCDPFallbackBrowserIntegration", "-v", "-count=1"]
